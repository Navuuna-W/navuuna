#!/bin/sh
# Blocks any push to main from this laptop.
# Why: the GitHub Free plan can't enforce branch protection on a private repo (ADR-001),
# so this hook does the job locally. Work on a branch and open a pull request instead.
# Run by the pre-commit framework (.pre-commit-config.yaml), which puts the target branch
# in PRE_COMMIT_REMOTE_BRANCH. Set it up once per clone — see .github/README.md.

if [ "$PRE_COMMIT_REMOTE_BRANCH" = "refs/heads/main" ]; then
  echo "Blocked: pushing to main is not allowed. Push your branch and open a pull request."
  exit 1
fi
exit 0

# Settings for the local stack (infra/docker-compose.yml). setup.sh copies this to
# infra/local/.env and fills in APP_KEY. Local values only — never reuse them on a server.

# Laravel
APP_NAME=Navuuna
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
LOG_CHANNEL=stderr
DB_CONNECTION=pgsql
DB_HOST=postgis
DB_PORT=5432
DB_DATABASE=navuuna
DB_USERNAME=navuuna
DB_PASSWORD=navuuna
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# Python signal service (K-09b)
NV_SIGNALS_DATABASE_URL=postgresql://navuuna:navuuna@postgis:5432/navuuna
NV_REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ROOT_USER=navuuna
MINIO_ROOT_PASSWORD=navuuna-local

# Module switches (ADR-012 §3). Leave it commented out to run every module. Set it to a
# comma-separated list, e.g. MODULES_ENABLED=water, to run only those modules; then restart:
# docker compose -f infra/docker-compose.yml up -d
# MODULES_ENABLED=water,roads
